{
  "name": "embigo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "embigo-db",
      "database_id": "c94d03f9-e1e5-4024-8bec-a3dce651cd79"
    }
  ]
}